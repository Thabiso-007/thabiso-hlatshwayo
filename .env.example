# Public inbox for both the contact form and the email links (set before building).
NEXT_PUBLIC_CONTACT_EMAIL=thabiso.hlatshwayo24@gmail.com

# Server-only Gmail SMTP credentials. Never commit a real app password.
SMTP_USER=
SMTP_PASSWORD=

# Optional advanced SMTP settings. Gmail defaults to implicit TLS on port 465.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# For port 587, set SMTP_SECURE=false; STARTTLS is still required.
